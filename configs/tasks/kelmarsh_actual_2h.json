{
  "name": "kelmarsh_actual_2h",
  "description": "kelmarsh 10-minute actual-power forecast, 2 h ahead from 24 h of history; B/C normal-operation masks scored in addition.",
  "dataset": "kelmarsh",
  "target": "power",
  "target_input": "power",
  "inputs": ["wind_speed", "wind_dir_sin", "wind_dir_cos", "power"],
  "history_minutes": 1440,
  "horizon_minutes": 120,
  "train_stride_minutes": 60,
  "eval_stride_minutes": 10,
  "splits": {"train": ["2016-04-15", "2022-01-01"],
             "valid": ["2022-01-01", "2023-01-01"],
             "test": ["2023-01-01", "2025-01-01"]},
  "train_mask": "observed",
  "valid_mask": "observed",
  "eval_mask": "observed",
  "extra_eval_masks": [{"mask": "normal_b", "target": "power"}, {"mask": "normal_c", "target": "power"}],
  "report_horizons_minutes": [60, 120]
}
